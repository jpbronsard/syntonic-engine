 "desc": {
  "KF_rival": "rival: bench Kalman tuned against truth (training C3, R/Q_G/Q_B grid), reset arming",
  "KF_bench": "reference: the bench published tuned Kalman (R x8192, Q_G ~0, Q_B fixed)",
  "KF_ridge": "reference: another point of the rival flat ridge (R x2^16, Q_B x2^18)",
  "KF_facts": "reference: Kalman set from facts (R = var_tilt, Q_G = lam_idle), bench arming",
  "KF_facts_reset": "reference: the same with the bias state reset at arming",
  "LAW_c1": "reference: published law kappa = 1",
  "a_fp_raw": "(a) fixed point tau = sqrt(r(2tau)/lam(2tau)), raw-record curves",
  "a_min_raw": "(a) residual Allan crossover tau = T*/sqrt(3), raw-record curves",
  "a_fp_loop": "(a) fixed point, looped-record (bench-world) curves",
  "a_min_loop": "(a) crossover, looped-record (bench-world) curves",
  "d_law_noceil": "(d) published law without the 30 s ceiling",
  "d_law_lamidle": "(d) published law with lambda = idle ARW in every regime",
  "d_law_btab": "(d) published law + logged per-throttle bias table",
  "b_ss": "(b) two-state law, r = live s2, q_theta = lam_idle, q_b = idle RRW bound (T_rec/4)",
  "b_ss_qb2": "(b) as b_ss with q_b at T_rec/2 (sensitivity)",
  "b_ss_ceil": "(b) as b_ss with the 30 s ceiling on 1/k1 (sensitivity)",
  "c_ss_raw": "(c) two-state law, r at the operating scale 2/k1, raw-record curves",
  "c_ss_loop": "(c) two-state law, r at the operating scale, looped-record curves",
  "d_b_ss_btab": "(d) b_ss + logged per-throttle bias table",
  "b_tv": "(b/d) two-state Kalman, Riccati online, R = live s2/DTA, Q from idle facts",
  "b_tv_qb2": "(b/d) as b_tv with q_b at T_rec/2",
  "d_b_tv_btab": "(d) b_tv + logged per-throttle bias table",
  "LAW_c2.8": "reference: published law c = 2.8 (calibrated against truth)"
